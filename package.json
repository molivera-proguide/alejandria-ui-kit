{
  "name": "alejandria-ui-kit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.5.0",
  "scripts": {
    "dev:web": "pnpm --filter @alejandria/web dev",
    "storybook": "pnpm --filter @alejandria/ui-kit storybook",
    "build": "pnpm -r build",
    "build:ui": "pnpm --filter @alejandria/ui-kit build",
    "build:web": "pnpm --filter @alejandria/web build",
    "build-storybook": "pnpm --filter @alejandria/ui-kit build-storybook",
    "pack:ui": "pnpm --filter @alejandria/ui-kit pack && node scripts/copy-knowledge.mjs --clean",
    "audit:sdd": "node scripts/sdd-audit.mjs",
    "kanban": "node scripts/gen-kanban.mjs",
    "kanban:serve": "node scripts/kanban-server.mjs",
    "skills:sync": "node scripts/sync-skills.mjs",
    "skills:sync:dry": "node scripts/sync-skills.mjs --dry-run"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "typescript": "^6.0.3",
    "yaml": "^2.4.0"
  }
}
